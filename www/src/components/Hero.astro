---
// The product doing its job: a camera picture with its baseline and slouch lines, and the nudge.
import Toast from "./Toast.astro";
---

<section class="container hero">
  <div class="copy">
    <span class="eyebrow">Posture, gently</span>
    <h1 class="display">Psst, sit <span class="up">up</span>.</h1>
    <p class="lede">
      slouchup is a friendly pair of eyes that lives in your tray. It notices when your head sinks or
      leans in, and nudges you once. Then it leaves you alone.
    </p>
    <div class="ctas">
      <a class="cta primary" href="#download">Download slouchup</a>
      <a class="cta outline" href="#how">See how it works</a>
    </div>
  </div>
  <div class="visual">
    <div class="frame">
      <svg viewBox="0 0 600 380" aria-hidden="true">
        <rect width="600" height="380" fill="#E9E2CF" />
        <rect x="50" y="110" width="84" height="270" fill="#B49A7C" />
        <rect x="440" y="60" width="100" height="126" rx="6" fill="#6E6A60" />
        <rect x="452" y="72" width="76" height="102" fill="#F6D77A" />
        <path d="M60 380 C 100 300 200 280 300 280 C 400 280 500 300 540 380 Z" fill="#3B6FD8" />
        <ellipse cx="300" cy="160" rx="80" ry="96" fill="#D9A27A" />
        <circle cx="270" cy="152" r="7" fill="#22201C" />
        <circle cx="330" cy="152" r="7" fill="#22201C" />
        <path d="M0 130 H600" stroke="#22201C" stroke-width="2" />
        <path d="M0 180 H600" stroke="#C8432A" stroke-width="2.5" stroke-dasharray="10 8" />
      </svg>
    </div>
    <div class="toast"><Toast reason="You're 32% closer to the screen than usual." /></div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-block: 48px 80px; }
  .copy { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .visual { position: relative; flex: 1 1 480px; min-width: 0; padding-bottom: 72px; }
  .frame { overflow: hidden; border: 3px solid var(--ink); border-radius: var(--radius-lg); background: #E9E2CF; box-shadow: 8px 8px 0 var(--ink); }
  .frame svg { display: block; width: 100%; height: auto; }
  .toast { position: absolute; right: -8px; bottom: 0; max-width: 100%; }
  /* On a phone the nudge would cover the picture, so it overlaps only the corner. */
  @media (max-width: 560px) {
    .visual { padding-bottom: 0; }
    .toast { position: relative; right: auto; margin: -40px 0 0 16px; }
  }
</style>
