---
// The product doing its job: a camera picture with its baseline and slouch lines, and the nudge.
import { BASELINE, person } from "../brand/person";
import Toast from "./Toast.astro";

// The slouch line sits just above the leaning person's eyes, as it would when the nudge fires.
const lines = [
  { name: "baseline", y: BASELINE, width: 62 },
  { name: "slouch", y: BASELINE + 28, width: 52 },
];
---

<section class="container hero">
  <div class="copy">
    <span class="eyebrow">Posture, gently</span>
    <h1 class="display">Psst, sit <span class="up">up</span>.</h1>
    <p class="lede">
      slouchup is a friendly pair of eyes that lives in your tray. It notices when your head sinks or
      leans in, and nudges you once. Then it leaves you alone.
    </p>
    <div class="ctas">
      <a class="cta primary" href="#download">Download slouchup</a>
      <a class="cta outline" href="#how">See how it works</a>
    </div>
  </div>
  <div class="visual">
    <div class="frame">
      <svg viewBox="0 0 640 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <Fragment set:html={person("lean")} />
        {
          lines.map(({ name, y, width }) => (
            <g class={`line ${name}`}>
              <path d={`M0 ${y} H640`} />
              <rect x="16" y={y - 10} width={width} height="20" rx="10" />
              <text x={16 + width / 2} y={y + 4}>{name}</text>
            </g>
          ))
        }
      </svg>
    </div>
    <div class="toast"><Toast reason="You're 32% closer to the screen than usual." /></div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-block: 48px 80px; }
  .copy { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .visual { position: relative; flex: 1 1 480px; min-width: 0; padding-bottom: 136px; }
  .frame { overflow: hidden; border: 3px solid var(--ink); border-radius: var(--radius-lg); background: #E9E2CF; box-shadow: 8px 8px 0 var(--ink); }
  .frame svg { display: block; width: 100%; height: auto; aspect-ratio: 600 / 380; }
  .line path { stroke-width: 2; }
  .line text { font: 600 11px var(--font-body); text-anchor: middle; fill: var(--butter); }
  .baseline path { stroke: var(--ink); }
  .baseline rect { fill: var(--ink); }
  .slouch path { stroke: var(--tomato-text); stroke-width: 2.5; stroke-dasharray: 10 8; }
  .slouch rect { fill: var(--tomato-fill); }
  /* The nudge overlaps only the bottom edge of the picture, below the person's chin. */
  .toast { position: absolute; right: -8px; bottom: 0; max-width: 100%; }
  @media (max-width: 560px) {
    .visual { padding-bottom: 0; }
    .toast { position: relative; right: auto; margin: -16px 0 0 16px; }
  }
</style>
