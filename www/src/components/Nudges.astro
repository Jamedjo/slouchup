---
// The nagging defaults are the app's own, from posture::Settings::default.
import Band from "./Band.astro";
import Toast from "./Toast.astro";

const defaults = [
  { name: "Nag after", value: "1.5 s" },
  { name: "Wait between", value: "10 s" },
  { name: "Repeat every", value: "60 s" },
];
---

<Band id="nudges" ground="butter">
  <div class="nudges">
    <div class="copy">
      <h2 class="h2">Nudges, not nags</h2>
      <p class="lede">
        You decide how patient it is: how long a slouch lasts before it speaks up, how long it waits
        between slouches, and how often it repeats.
      </p>
      <dl>
        {
          defaults.map(({ name, value }) => (
            <div>
              <dt>{name}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="example"><Toast reason="Your head has sunk lower than usual." /></div>
  </div>
</Band>

<style>
  .nudges { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .lede { font-size: 1.15rem; }
  .example { flex: 1 1 400px; min-width: 0; }
  dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; }
  dl div { padding: 16px; border: 2px solid var(--ink); border-radius: var(--radius-md); background: var(--white); }
  dt { font-size: 13px; font-weight: 600; }
  dd { margin: 6px 0 0; font: 600 1.75rem var(--font-display); color: var(--tomato-text); }
</style>
