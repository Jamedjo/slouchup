---
import Band from "./Band.astro";

const points = [
  { title: "Your usual, not an ideal", detail: "Compared with how you sat when you calibrated." },
  { title: "On your computer", detail: "Everything runs on your computer. Video never leaves it." },
  { title: "Pause in one click", detail: "From the tray, any time. The tray icon goes grey while paused." },
  { title: "You set the limits", detail: "How far your eyes drop and how much your face grows before it counts." },
];
---

<Band id="privacy">
  <div class="privacy">
    <div class="copy">
      <h2 class="h2">Two measurements</h2>
      <p class="lede">
        How high your head sits, and how close it is to the screen.
      </p>
    </div>
    <ul>
      {
        points.map(({ title, detail }) => (
          <li>
            <strong>{title}</strong>
            <span>{detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Band>

<style>
  .privacy { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .copy { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .lede { font-size: 1.15rem; }
  ul { flex: 1 1 420px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 2px solid var(--ink); border-radius: var(--radius-md); background: var(--white); }
  strong { font: var(--weight-display) 1.25rem var(--font-display); }
  span { font-size: 15px; line-height: 1.45; color: var(--stone); }
</style>
