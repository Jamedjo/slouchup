---
import Wordmark from "./Wordmark.astro";
---

<header class="container">
  <Wordmark size="30px" />
  <nav aria-label="Main">
    <a href="#how">How it works</a>
    <a href="#nudges">Nudges</a>
    <a href="#privacy">Privacy</a>
    <a class="cta primary" href="#download">Download</a>
  </nav>
</header>

<style>
  header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-weight: 600; }
  nav a { color: var(--ink); text-decoration: none; }
  nav .cta { min-height: 44px; padding: 0 20px; font-size: 16px; color: var(--butter); }
</style>
