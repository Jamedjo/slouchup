---
import Wordmark from "./Wordmark.astro";
---

<header class="container">
  <Wordmark size="30px" />
  <nav aria-label="Main">
    <a href="#how">How it works</a>
    <a href="#nudges">Nudges</a>
    <a href="#privacy">Privacy</a>
  </nav>
  <a class="cta primary" href="#download">Download</a>
</header>

<style>
  header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px 28px; padding-block: 20px; }
  nav { display: flex; justify-content: flex-end; gap: 28px; font-weight: 600; }
  nav a { color: var(--ink); text-decoration: none; white-space: nowrap; }
  .cta { min-height: 44px; padding: 0 20px; font-size: 16px; color: var(--butter); }
  /* Too narrow for one row: the logo and Download keep the top row, the links go underneath. */
  @media (max-width: 639px) {
    header { grid-template-columns: 1fr auto; row-gap: 4px; }
    nav { grid-row: 2; grid-column: 1 / -1; justify-content: flex-start; gap: 24px; }
    nav a { padding-block: 8px; }
  }
</style>
