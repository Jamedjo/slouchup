---
import { trayMark, type State } from "../brand/tray";

interface Props {
  state: State;
  size: number;
}

const { state, size } = Astro.props;
---

<span class="mark" style={`width: ${size}px; height: ${size}px`} set:html={trayMark(state)} />

<style>
  .mark { display: inline-flex; flex: none; }
  .mark :global(svg) { width: 100%; height: 100%; }
</style>
