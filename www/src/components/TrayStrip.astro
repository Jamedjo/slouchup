---
import Band from "./Band.astro";
import TrayMark from "./TrayMark.astro";
import type { State } from "../brand/tray";

const states: { state: State; label: string }[] = [
  { state: "upright", label: "Sitting tall" },
  { state: "slouch", label: "Sinking" },
  { state: "lost", label: "Out of frame" },
];
---

<Band ground="ink" strip>
  <div class="strip">
    <p>Lives in your tray.<br />Sinks when you do.</p>
    <ul>
      {
        states.map(({ state, label }) => (
          <li class={state}>
            <TrayMark state={state} size={40} />
            {label}
          </li>
        ))
      }
    </ul>
  </div>
</Band>

<style>
  .strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 48px; }
  p { flex: 1 1 260px; margin: 0; font: var(--weight-display) 1.75rem/1.2 var(--font-display); letter-spacing: -0.02em; }
  ul { display: flex; flex-wrap: wrap; gap: 32px; margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; gap: 12px; font-weight: 600; }
  .upright :global(.mark) { color: var(--state-upright); }
  .slouch :global(.mark) { color: var(--state-slouch); }
  .lost :global(.mark) { color: var(--state-lost); }
</style>
